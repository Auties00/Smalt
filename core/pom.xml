<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.auties00</groupId>
        <artifactId>smalt-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>smalt-core</artifactId>
    <packaging>jar</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Smalt core: the media model, the codec registries, every container, image and audio processing, loudness, subtitles, PCM, tag editing and XMP</description>

    <dependencies>
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The test kit's DASH validator reads the MPD and its schema with java.xml, which the core module does
                not require; its tests, patched into the module, read it through this flag. The other modules' tests
                load the test kit from the test jar on the class path, which reads every module.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.xml</arg>
                                <arg>--add-reads</arg>
                                <arg>com.github.auties00.smalt=java.xml</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${smalt.test.argLine} --add-modules java.xml --add-reads com.github.auties00.smalt=java.xml</argLine>
                </configuration>
            </plugin>
            <!--
                The test jar carries the test kit (oracles, fixtures, conformance vectors, quality metrics and
                the shared test helpers) that the other modules' tests use; core's own tests stay out of it.
                It is built in every profile, the release one included, because the other modules' tests
                compile against it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <configuration>
                            <skip>false</skip>
                            <includes>
                                <include>com/github/auties00/smalt/testkit/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
