<?xml version="1.0" encoding="UTF-8"?>
<!--
    smalt-parent: the reactor and the parent of every code artifact (dependency versions, compiler, test and jar
    configuration). Metadata, plugin versions and the release profiles come from smalt-build (build/pom.xml),
    which smalt-bom inherits too. child.*.inherit.append.path="false" is repeated here because the flag applies
    to the children of the pom that declares it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.auties00</groupId>
        <artifactId>smalt-build</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>build/pom.xml</relativePath>
    </parent>

    <artifactId>smalt-parent</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Smalt: pure-Java image, audio and video codecs, containers, processing and capture</description>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false"/>

    <modules>
        <module>build</module>
        <module>bom</module>
        <module>kernel-lint</module>
        <module>core</module>
        <module>image</module>
        <module>audio</module>
        <module>video</module>
        <module>mpeg</module>
        <module>capture</module>
        <module>raw</module>
        <module>desktop</module>
        <module>aot</module>
        <module>it</module>
    </modules>

    <properties>
        <junit.version>5.13.4</junit.version>
        <jmh.version>1.37</jmh.version>
        <chicory.version>1.7.5</chicory.version>
        <jazzer.version>0.30.0</jazzer.version>
        <!-- The JUnit Platform release of junit.version; the standalone Jazzer runner needs its launcher -->
        <junit.platform.version>1.13.4</junit.platform.version>
        <!--
            Jazzer instruments the classes loaded after a fuzz test starts. A normal build replays the fuzz inputs
            without that instrumentation, so the other tests of the same JVM run unchanged; fuzzing sets it to true
            (tools/fuzz/README.md).
        -->
        <jazzer.hooks>false</jazzer.hooks>
        <!-- false runs every kernel on its scalar twin (CI's scalar leg): mvn test -Dsmalt.test.simd=false -->
        <smalt.test.simd>true</smalt.test.simd>
        <!-- Extra test JVM options, for example the hostile-input job's 256 MiB heap: mvn test -Dsmalt.test.jvmArgs=-Xmx256m -->
        <smalt.test.jvmArgs></smalt.test.jvmArgs>
        <!-- The JUnit tags a build leaves out: the multi-gigabyte conformance suites run in their own CI jobs
             (Av1ArgonTest: mvn test -Dsmalt.test.excludedGroups=none -Dgroups=argon -Dsmalt.test.argon=profile0_core) -->
        <smalt.test.excludedGroups>argon</smalt.test.excludedGroups>
        <!-- The coverage agent the coverage profile adds to the test JVMs -->
        <smalt.test.agent></smalt.test.agent>
        <!-- jdk.management: the allocation tests read the per-thread allocation counter reflectively;
             EnableDynamicAgentLoading: the fuzz tests' Jazzer attaches its agent at run time. Tests run at the
             JVM's default thread stack size, as applications do. -->
        <!--
            Test JVMs per module, side by side (surefire's forkCount: a number, or a multiple of the cores such as
            1C), each reused for many test classes: mvn verify -Dsmalt.test.forks=1C. The it module (its JIT stress
            test and guard self-test) and the capture tests always run in one. Helpers that several test classes
            share write under the fork's own target directory (the test kit's Scratch); smalt.test.heap caps each
            fork's heap when several share a machine, for example -XX:MaxRAMPercentage=18 with four.
        -->
        <smalt.test.forks>1</smalt.test.forks>
        <smalt.test.heap></smalt.test.heap>
        <smalt.test.argLine>${smalt.test.agent} --add-modules jdk.incubator.vector,jdk.management --enable-native-access=ALL-UNNAMED -XX:+EnableDynamicAgentLoading -Dsmalt.simd=${smalt.test.simd} ${smalt.test.heap} ${smalt.test.jvmArgs}</smalt.test.argLine>
        <!--
            The forbidden-apis check of the Vector API bans (tools/lint/forbidden-vector.txt) runs in verify only when
            the Maven JVM has the incubator module, which this repository's .mvn/jvm.config adds and .mvn/maven.config
            turns this property off for; a reactor that builds Smalt from elsewhere (Cobalt's local-smalt profile)
            reads neither, so the check stays off there.
        -->
        <smalt.forbiddenapis.skip>true</smalt.forbiddenapis.skip>
        <!-- The release profile sets it: these test jars feed only the unpublished it module, so they are not published
             (core's test jar, the test kit every module's tests compile against, is built in every profile) -->
        <smalt.skipTestJar>false</smalt.skipTestJar>
    </properties>

    <dependencyManagement>
        <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-image</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-audio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-video</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-mpeg</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-capture</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-raw</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-desktop</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-aot</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-image</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-audio</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-video</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-mpeg</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-capture</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smalt-raw</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
        </dependency>
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <version>${jazzer.version}</version>
            <!-- JUnit comes from junit.version, not the older release jazzer-junit was built against -->
            <exclusions>
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>runtime</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>wasi</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dylibso.chicory</groupId>
            <artifactId>compiler</artifactId>
            <version>${chicory.version}</version>
        </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Every module's tests use JUnit and may hold JMH benchmarks (the JMH annotation processor runs on test sources) -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${smalt.java.release}</release>
                    </configuration>
                    <executions>
                        <!-- Doc comments the doclet would drop, and exported API naming a type its module does not export -->
                        <execution>
                            <id>default-compile</id>
                            <configuration>
                                <compilerArgs>
                                    <arg>-Xlint:dangling-doc-comments,exports</arg>
                                </compilerArgs>
                            </configuration>
                        </execution>
                        <execution>
                            <id>default-testCompile</id>
                            <configuration>
                                <annotationProcessorPaths>
                                    <annotationProcessorPath>
                                        <groupId>org.openjdk.jmh</groupId>
                                        <artifactId>jmh-generator-annprocess</artifactId>
                                        <version>${jmh.version}</version>
                                    </annotationProcessorPath>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>${smalt.test.argLine}</argLine>
                        <forkCount>${smalt.test.forks}</forkCount>
                        <reuseForks>true</reuseForks>
                        <excludedGroups>${smalt.test.excludedGroups}</excludedGroups>
                        <systemPropertyVariables>
                            <jazzer.hooks>${jazzer.hooks}</jazzer.hooks>
                            <!-- The test kit's Scratch directories: one per fork -->
                            <smalt.test.fork>fork-${surefire.forkNumber}</smalt.test.fork>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>test-jar</id>
                            <goals>
                                <goal>test-jar</goal>
                            </goals>
                            <configuration>
                                <skipIfEmpty>true</skipIfEmpty>
                                <skip>${smalt.skipTestJar}</skip>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!--
                    Runs JMH benchmarks and scratch mains from src/test/java against the test class path:
                    mvn -DskipTests test-compile exec:exec -Dexec.executable=java
                        -Dexec.args="add-modules-flag -cp %classpath org.openjdk.jmh.Main <regex>"
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <configuration>
                        <classpathScope>test</classpathScope>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <!--
                The Vector API bans: no convenience method (vector-convenience) and no reinterpretAs*
                (vector-reinterpret) anywhere in the main code, and no jdk.incubator.vector type outside the Vector*
                classes (vector-confined), since linking a class that names one fails on a JVM started without the
                module; and no transcendental java.lang.Math method (strict-math, tools/lint/forbidden-math.txt),
                whose results may depend on the platform. KernelLintSuppress on a method accepts a finding, as for the
                kernel lint.
            -->
            <plugin>
                <groupId>de.thetaphi</groupId>
                <artifactId>forbiddenapis</artifactId>
                <configuration>
                    <skip>${smalt.forbiddenapis.skip}</skip>
                    <failOnUnsupportedJava>true</failOnUnsupportedJava>
                    <suppressAnnotations>
                        <annotation>**.KernelLintSuppress</annotation>
                    </suppressAnnotations>
                </configuration>
                <executions>
                    <execution>
                        <id>vector-api</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <signaturesFiles>
                                <signaturesFile>${maven.multiModuleProjectDirectory}/tools/lint/forbidden-vector.txt</signaturesFile>
                            </signaturesFiles>
                        </configuration>
                    </execution>
                    <execution>
                        <id>vector-confined</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <signatures><![CDATA[
@defaultMessage [vector-confined] only the Vector* classes may name jdk.incubator.vector types: a class that does fails to link where the module is absent
jdk.incubator.vector.**
]]></signatures>
                            <excludes>
                                <exclude>**/Vector*.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>strict-math</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <signaturesFiles>
                                <signaturesFile>${maven.multiModuleProjectDirectory}/tools/lint/forbidden-math.txt</signaturesFile>
                            </signaturesFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Javadoc lints, two runs of the javadoc tool (CLAUDE.md, Documentation section 11):
            - javadoc:javadoc-no-fork (default-cli): doclint "reference" on every member, private included; fails on
              a {@link}, @see, @param or @throws that does not resolve.
            - javadoc:javadoc-no-fork@doclint-all: doclint "all" on the exported API (protected and public members
              of the unqualified-exported packages), missing comments and tags included. It never fails the build:
              tools/lint/doclint.py reads its warnings from the build log and gates them with tools/lint/baseline.tsv.
            Compile in the same invocation, and hand the second run's log to the lint (its javadoc-log option):
                mvn -Pjavadoc-check -fae compile javadoc:javadoc-no-fork -DskipTests
                mvn -Pjavadoc-check -fae compile javadoc:javadoc-no-fork@doclint-all -DskipTests > javadoc.log
        -->
        <profile>
            <id>javadoc-check</id>
            <build>
                <plugins>
                    <!--
                        The javadoc plugin skips a module whose options and source list are unchanged, without
                        looking at the sources' contents, and a skipped run prints no doclint output: drop its
                        record of the previous run so that every run lints the current sources.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>javadoc-stale-data</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>*stale-data.txt</include>
                                            </includes>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <show>private</show>
                            <doclint>reference</doclint>
                            <failOnError>true</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <detectLinks>false</detectLinks>
                            <detectJavaApiLink>false</detectJavaApiLink>
                            <detectOfflineLinks>false</detectOfflineLinks>
                            <additionalOptions combine.children="append">
                                <additionalOption>-Xmaxerrs 100000</additionalOption>
                                <additionalOption>-Xmaxwarns 100000</additionalOption>
                            </additionalOptions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>doclint-all</id>
                                <!-- Run only when named on the command line -->
                                <phase>none</phase>
                                <goals>
                                    <goal>javadoc-no-fork</goal>
                                </goals>
                                <configuration>
                                    <show>protected</show>
                                    <doclint>all</doclint>
                                    <failOnError>false</failOnError>
                                    <quiet>false</quiet>
                                    <outputDirectory>${project.build.directory}/doclint-all</outputDirectory>
                                    <!-- The exported API only: internal packages are exported to Smalt modules at most -->
                                    <excludePackageNames>*.internal:*.internal.*</excludePackageNames>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Line and branch coverage (JaCoCo) of every module's tests, used as a map of the spec features no test
            exercises (tools/coverage/README.md). Each module writes target/jacoco.exec and its report under
            target/site/jacoco; it adds the report of every module together under target/site/jacoco-aggregate:
                mvn -Pcoverage verify
                python tools/coverage/coverage.py it/target/site/jacoco-aggregate/jacoco.xml
        -->
        <profile>
            <id>coverage</id>
            <properties>
                <smalt.test.agent>@{jacocoArgLine}</smalt.test.agent>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>coverage-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>jacocoArgLine</propertyName>
                                    <includes>
                                        <include>com/github/auties00/smalt/**</include>
                                    </includes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>coverage-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- The release profile itself is in smalt-build; here it only stops building the unpublished test jars -->
        <profile>
            <id>release</id>
            <properties>
                <smalt.skipTestJar>true</smalt.skipTestJar>
            </properties>
        </profile>
    </profiles>
</project>
