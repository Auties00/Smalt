# Maven
target/
*.class
hs_err_pid*
replay_pid*

# IDEs
.idea/
*.iml
.settings/
.project
.classpath
.vscode/

# OS
.DS_Store
Thumbs.db

# Python (codegen scripts)
__pycache__/
*.pyc

# Jazzer's JUnit fuzzing mode (tools/fuzz/README.md): its generated corpus and the findings it writes to the
# module directory; saved findings live under src/test/resources/fuzz-regressions
/*/.cifuzz-corpus/
/*/crash-*
/*/timeout-*
/*/oom-*
/*/slow-unit-*
/*/leak-*

# Oracle data the CI oracle jobs write before caching them
.oracle-data/
