# Shell and Python scripts run on Linux CI runners: keep them LF whatever core.autocrlf says.
*.sh text eol=lf
*.py text eol=lf
*.tsv text eol=lf
# Java sources and the codegen templates are LF everywhere, so that a regenerated kernel compares equal to the
# committed file (tools/codegen/check.py) and no checkout rewrites every line.
*.java text eol=lf
*.head text eol=lf
*.template text eol=lf
# The I/O behavior samples are pinned by SHA-256 (tools/testdata/behavior/samples.tsv), so no checkout may rewrite
# them; their golden dumps are plain text compared with LF line endings.
core/src/test/resources/samples/** -text
image/src/test/resources/samples/** -text
*.dump text eol=lf
