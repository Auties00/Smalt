# Shell and Python scripts run on Linux CI runners: keep them LF whatever core.autocrlf says.
*.sh text eol=lf
*.py text eol=lf
*.tsv text eol=lf
# Java sources and the codegen templates are LF everywhere, so that a regenerated kernel compares equal to the
# committed file (tools/codegen/check.py) and no checkout rewrites every line.
*.java text eol=lf
*.head text eol=lf
*.template text eol=lf
# The I/O behavior samples are pinned by SHA-256 (tools/testdata/behavior/samples.tsv), so no checkout may rewrite
# them; their golden dumps are plain text compared with LF line endings.
core/src/test/resources/samples/** -text
image/src/test/resources/samples/** -text
*.dump text eol=lf
# Fuzz seeds and saved findings are byte-exact inputs, text-looking ones (subtitles, XMP) included.
**/src/test/resources/**/*Inputs/** -text -diff
**/src/test/resources/fuzz-regressions/** -text -diff
# The Kakadu JPEG 2000 fixtures and their PGM decodes are pinned by SHA256SUMS next to them; no checkout may rewrite
# a PGM header's line feeds.
image/src/test/resources/com/github/auties00/smalt/image/jp2/kakadu-e5/** -text -diff
image/src/test/resources/com/github/auties00/smalt/image/jp2/kakadu-cbap/** -text -diff
# Reference outputs stored as raw float32 samples are byte-exact.
**/src/test/resources/**/*.f32 -text -diff
# Little CMS reference outputs of the color tests are raw samples, byte-exact.
core/src/test/resources/com/github/auties00/smalt/image/color/proofing/*.8 -text -diff
core/src/test/resources/com/github/auties00/smalt/image/color/proofing/*.16 -text -diff
core/src/test/resources/com/github/auties00/smalt/image/color/proofing/*.x16 -text -diff
core/src/test/resources/com/github/auties00/smalt/image/color/proofing/*.g8 -text -diff
core/src/test/resources/com/github/auties00/smalt/image/color/proofing/*.g16 -text -diff
core/src/test/resources/com/github/auties00/smalt/image/color/proofing/*.kt -text -diff
# CineForm vectors are raw samples and decodes, byte-exact.
**/src/test/resources/**/*.cfhd -text -diff
# The USAC concealment streams and their meta files are pinned by usac.sha256 next to them.
mpeg/src/test/resources/com/github/auties00/smalt/audio/aac/usac/*.raw -text -diff
mpeg/src/test/resources/com/github/auties00/smalt/audio/aac/usac/*.meta -text -diff
# The pinned AAC-ELD low delay SBR streams of AacLowDelaySbrEncoderTest are byte-exact encoder output with their
# libxaac metadata files; no checkout may rewrite them.
mpeg/src/test/resources/com/github/auties00/smalt/audio/aac/eld-sbr/** -text -diff
# The USAC time-warped filterbank oracle outputs are pinned by tw.sha256 next to them.
mpeg/src/test/resources/com/github/auties00/smalt/audio/aac/internal/usac/*.f32 -text -diff
